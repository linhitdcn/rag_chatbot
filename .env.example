# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by ingestion, the public chat API and team invites. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Platform-default provider keys. Workspaces can add their own under Settings → API Keys, which take priority.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 32+ random characters; encrypts stored API keys (AES-256-GCM). Generate: openssl rand -base64 32
# Changing it makes previously saved keys undecryptable.
ENCRYPTION_KEY=

# Public URL of this app (used in the embed snippet and auth/invite redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
