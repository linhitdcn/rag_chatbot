# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by ingestion, the public chat API and team invites. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Platform-default provider keys (all optional). Workspaces can add their own under Settings → API Keys,
# which take priority. Free tiers (no card): Google Gemini (aistudio.google.com/apikey), Groq (console.groq.com/keys).
# Gemini is also the default embedding provider, so set at least GOOGLE_GENERATIVE_AI_API_KEY (or add it in the app).
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 32+ random characters; encrypts stored API keys (AES-256-GCM). Generate: openssl rand -base64 32
# Changing it makes previously saved keys undecryptable.
ENCRYPTION_KEY=

# Public URL of this app (used in the embed snippet and auth/invite redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string for running migrations (Supabase → Connect → Session pooler). Optional: the app itself uses the Supabase API.
DATABASE_URL=
